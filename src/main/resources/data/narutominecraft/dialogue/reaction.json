{"format":1,"lines":[{"id":14788,"pool":"reaction.touched","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"Oh. That's... I didn't expect that. Thank you, {player}."},{"id":14789,"pool":"reaction.touched","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"You really mean that, don't you? I can tell."},{"id":14790,"pool":"reaction.touched","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"I'm going to remember you said that."},{"id":14791,"pool":"reaction.touched","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"That's a kind way to see it. Kinder than I'd have been."},{"id":14792,"pool":"reaction.touched","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"Give me a moment. That landed somewhere soft."},{"id":14793,"pool":"reaction.touched","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"I'm glad I asked you, of all people."},{"id":14794,"pool":"reaction.pleased","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Good answer. I hoped you'd say that."},{"id":14795,"pool":"reaction.pleased","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's just what I'd have said. Great minds, {player}."},{"id":14796,"pool":"reaction.pleased","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Yes! Exactly. I knew we'd think alike."},{"id":14797,"pool":"reaction.pleased","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I like that. I like that a lot."},{"id":14798,"pool":"reaction.pleased","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Now that's a sensible way to look at it."},{"id":14799,"pool":"reaction.pleased","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Ha, good. You pass. Not that it was a test. It was a bit of a test."},{"id":14800,"pool":"reaction.amused","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Ha! I wasn't expecting that."},{"id":14801,"pool":"reaction.amused","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"You're joking. ...You're not joking? Even better."},{"id":14802,"pool":"reaction.amused","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I'm going to be laughing about that all afternoon."},{"id":14803,"pool":"reaction.amused","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's the strangest answer I've heard all week. I love it."},{"id":14804,"pool":"reaction.amused","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Well, that's one way to go about it!"},{"id":14805,"pool":"reaction.amused","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Pfft. Sorry. No, go on. I'm listening. Mostly laughing."},{"id":14806,"pool":"reaction.impressed","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Huh. I wouldn't have thought of that."},{"id":14807,"pool":"reaction.impressed","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's clever, {player}. Really clever."},{"id":14808,"pool":"reaction.impressed","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"You've thought about this before, haven't you? It shows."},{"id":14809,"pool":"reaction.impressed","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I'll be stealing that idea, if you don't mind."},{"id":14810,"pool":"reaction.impressed","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's braver than I'd have been."},{"id":14811,"pool":"reaction.impressed","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Well. You've surprised me. In a good way."},{"id":14812,"pool":"reaction.fine","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Hm. Fair enough."},{"id":14813,"pool":"reaction.fine","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"All right. I can see that."},{"id":14814,"pool":"reaction.fine","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's an answer. Thank you."},{"id":14815,"pool":"reaction.fine","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I suppose so, yes."},{"id":14816,"pool":"reaction.fine","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Mm. I'll think about it."},{"id":14817,"pool":"reaction.fine","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Not what I'd say, but it's not wrong."},{"id":14818,"pool":"reaction.stung_but_respects","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's not what I wanted to hear. But it's honest, and I'll take honest."},{"id":14819,"pool":"reaction.stung_but_respects","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Ouch. All right. You're probably right."},{"id":14820,"pool":"reaction.stung_but_respects","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I don't like it. I can't argue with it, either."},{"id":14821,"pool":"reaction.stung_but_respects","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That stung a little. Thank you for not just saying what I wanted."},{"id":14822,"pool":"reaction.stung_but_respects","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Hm. You didn't soften it. I respect that, even if it smarts."},{"id":14823,"pool":"reaction.stung_but_respects","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Fine. You win that one. I'll be sulking quietly."},{"id":14824,"pool":"reaction.hurt","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Oh. I see. That's how you feel."},{"id":14825,"pool":"reaction.hurt","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I didn't think you'd say that, {player}."},{"id":14826,"pool":"reaction.hurt","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Right. Let's... talk about something else."},{"id":14827,"pool":"reaction.hurt","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's not the {player} I thought I knew."},{"id":14828,"pool":"reaction.hurt","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I'll pretend I didn't hear that. Nearly."},{"id":14829,"pool":"reaction.hurt","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That hurt more than you'd think."},{"id":14830,"pool":"reaction.noticed_contradiction","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Wait. That's not what you told me before."},{"id":14831,"pool":"reaction.noticed_contradiction","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Hm. Last time you said the opposite. Which is it?"},{"id":14832,"pool":"reaction.noticed_contradiction","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"You've changed your tune since we last spoke. Have you changed your mind too?"},{"id":14833,"pool":"reaction.noticed_contradiction","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Funny. I remember you answering that differently."},{"id":14834,"pool":"reaction.noticed_contradiction","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That doesn't match what you said the other day, {player}."},{"id":14835,"pool":"reaction.noticed_contradiction","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I keep track, you know. That's not the answer you gave me before."},{"id":14836,"pool":"reaction.touched","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"Oh, you dear thing. Come here, I'm putting the kettle on for that."},{"id":14837,"pool":"reaction.touched","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"mood":"BLUSH","text":"I... thank you. Nobody's ever... thank you."},{"id":14838,"pool":"reaction.touched","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"...Hm. Thank you. I mean it."},{"id":14839,"pool":"reaction.pleased","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"YES! That's the answer! I knew you'd get it!"},{"id":14840,"pool":"reaction.pleased","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Correct. Good. Keep thinking like that."},{"id":14841,"pool":"reaction.pleased","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Precisely right. I'll make a note of it."},{"id":14842,"pool":"reaction.amused","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"HA! Oh, that's going straight into my collection of best answers."},{"id":14843,"pool":"reaction.amused","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"I shouldn't laugh. I'm not laughing. ...Fine, I'm laughing a little."},{"id":14844,"pool":"reaction.impressed","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"That's a better answer than the one in my book. I'm a little annoyed, honestly."},{"id":14845,"pool":"reaction.impressed","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Wait, how did you come up with that? Walk me through it. Every step."},{"id":14846,"pool":"reaction.impressed","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"That's practical. Practical impresses me. Well done."},{"id":14847,"pool":"reaction.fine","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Hm."},{"id":14848,"pool":"reaction.fine","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Safe answer. Not the one I'd have picked, but safe."},{"id":14849,"pool":"reaction.stung_but_respects","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"I'd strike anyone else for saying that. You, I'll listen to. Barely."},{"id":14850,"pool":"reaction.stung_but_respects","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"That's hard to hear. But you said it straight, and that's what friends do."},{"id":14851,"pool":"reaction.hurt","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"mood":"GLOOM","text":"Oh... all right. I'll be quiet now."},{"id":14852,"pool":"reaction.hurt","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"WHAT? How could you say that?! I thought you were on my side!"},{"id":14853,"pool":"reaction.hurt","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"I'd never say that about you. Remember that."},{"id":14854,"pool":"reaction.noticed_contradiction","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"I wrote down your last answer. It doesn't match. Which one should I cross out?"},{"id":14855,"pool":"reaction.noticed_contradiction","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"You told me otherwise before. Say what you mean, and mean it every time."},{"id":14856,"pool":"reaction.noticed_contradiction","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Ooh, you changed your answer! What changed your mind? I have to know."}]}
