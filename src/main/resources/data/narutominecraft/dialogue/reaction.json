{"format":1,"lines":[{"id":10346,"pool":"reaction.touched","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"Oh. That's... I didn't expect that. Thank you, {player}."},{"id":10347,"pool":"reaction.touched","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"You really mean that, don't you? I can tell."},{"id":10348,"pool":"reaction.touched","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"I'm going to remember you said that."},{"id":10349,"pool":"reaction.touched","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"That's a kind way to see it. Kinder than I'd have been."},{"id":10350,"pool":"reaction.touched","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"Give me a moment. That landed somewhere soft."},{"id":10351,"pool":"reaction.touched","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"I'm glad I asked you, of all people."},{"id":10352,"pool":"reaction.pleased","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Good answer. I hoped you'd say that."},{"id":10353,"pool":"reaction.pleased","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's just what I'd have said. Great minds, {player}."},{"id":10354,"pool":"reaction.pleased","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Yes! Exactly. I knew we'd think alike."},{"id":10355,"pool":"reaction.pleased","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I like that. I like that a lot."},{"id":10356,"pool":"reaction.pleased","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Now that's a sensible way to look at it."},{"id":10357,"pool":"reaction.pleased","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Ha, good. You pass. Not that it was a test. It was a bit of a test."},{"id":10358,"pool":"reaction.amused","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Ha! I wasn't expecting that."},{"id":10359,"pool":"reaction.amused","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"You're joking. ...You're not joking? Even better."},{"id":10360,"pool":"reaction.amused","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I'm going to be laughing about that all afternoon."},{"id":10361,"pool":"reaction.amused","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's the strangest answer I've heard all week. I love it."},{"id":10362,"pool":"reaction.amused","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Well, that's one way to go about it!"},{"id":10363,"pool":"reaction.amused","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Pfft. Sorry. No, go on. I'm listening. Mostly laughing."},{"id":10364,"pool":"reaction.impressed","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Huh. I wouldn't have thought of that."},{"id":10365,"pool":"reaction.impressed","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's clever, {player}. Really clever."},{"id":10366,"pool":"reaction.impressed","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"You've thought about this before, haven't you? It shows."},{"id":10367,"pool":"reaction.impressed","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I'll be stealing that idea, if you don't mind."},{"id":10368,"pool":"reaction.impressed","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's braver than I'd have been."},{"id":10369,"pool":"reaction.impressed","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Well. You've surprised me. In a good way."},{"id":10370,"pool":"reaction.fine","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Hm. Fair enough."},{"id":10371,"pool":"reaction.fine","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"All right. I can see that."},{"id":10372,"pool":"reaction.fine","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's an answer. Thank you."},{"id":10373,"pool":"reaction.fine","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I suppose so, yes."},{"id":10374,"pool":"reaction.fine","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Mm. I'll think about it."},{"id":10375,"pool":"reaction.fine","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Not what I'd say, but it's not wrong."},{"id":10376,"pool":"reaction.stung_but_respects","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's not what I wanted to hear. But it's honest, and I'll take honest."},{"id":10377,"pool":"reaction.stung_but_respects","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Ouch. All right. You're probably right."},{"id":10378,"pool":"reaction.stung_but_respects","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I don't like it. I can't argue with it, either."},{"id":10379,"pool":"reaction.stung_but_respects","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That stung a little. Thank you for not just saying what I wanted."},{"id":10380,"pool":"reaction.stung_but_respects","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Hm. You didn't soften it. I respect that, even if it smarts."},{"id":10381,"pool":"reaction.stung_but_respects","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Fine. You win that one. I'll be sulking quietly."},{"id":10382,"pool":"reaction.hurt","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Oh. I see. That's how you feel."},{"id":10383,"pool":"reaction.hurt","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I didn't think you'd say that, {player}."},{"id":10384,"pool":"reaction.hurt","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Right. Let's... talk about something else."},{"id":10385,"pool":"reaction.hurt","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's not the {player} I thought I knew."},{"id":10386,"pool":"reaction.hurt","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I'll pretend I didn't hear that. Nearly."},{"id":10387,"pool":"reaction.hurt","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That hurt more than you'd think."},{"id":10388,"pool":"reaction.noticed_contradiction","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Wait. That's not what you told me before."},{"id":10389,"pool":"reaction.noticed_contradiction","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Hm. Last time you said the opposite. Which is it?"},{"id":10390,"pool":"reaction.noticed_contradiction","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"You've changed your tune since we last spoke. Have you changed your mind too?"},{"id":10391,"pool":"reaction.noticed_contradiction","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Funny. I remember you answering that differently."},{"id":10392,"pool":"reaction.noticed_contradiction","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That doesn't match what you said the other day, {player}."},{"id":10393,"pool":"reaction.noticed_contradiction","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I keep track, you know. That's not the answer you gave me before."},{"id":10394,"pool":"reaction.touched","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"Oh, you dear thing. Come here, I'm putting the kettle on for that."},{"id":10395,"pool":"reaction.touched","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"mood":"BLUSH","text":"I... thank you. Nobody's ever... thank you."},{"id":10396,"pool":"reaction.touched","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"...Hm. Thank you. I mean it."},{"id":10397,"pool":"reaction.pleased","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"YES! That's the answer! I knew you'd get it!"},{"id":10398,"pool":"reaction.pleased","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Correct. Good. Keep thinking like that."},{"id":10399,"pool":"reaction.pleased","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Precisely right. I'll make a note of it."},{"id":10400,"pool":"reaction.amused","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"HA! Oh, that's going straight into my collection of best answers."},{"id":10401,"pool":"reaction.amused","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"I shouldn't laugh. I'm not laughing. ...Fine, I'm laughing a little."},{"id":10402,"pool":"reaction.impressed","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"That's a better answer than the one in my book. I'm a little annoyed, honestly."},{"id":10403,"pool":"reaction.impressed","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Wait, how did you come up with that? Walk me through it. Every step."},{"id":10404,"pool":"reaction.impressed","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"That's practical. Practical impresses me. Well done."},{"id":10405,"pool":"reaction.fine","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Hm."},{"id":10406,"pool":"reaction.fine","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Safe answer. Not the one I'd have picked, but safe."},{"id":10407,"pool":"reaction.stung_but_respects","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"I'd strike anyone else for saying that. You, I'll listen to. Barely."},{"id":10408,"pool":"reaction.stung_but_respects","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"That's hard to hear. But you said it straight, and that's what friends do."},{"id":10409,"pool":"reaction.hurt","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"mood":"GLOOM","text":"Oh... all right. I'll be quiet now."},{"id":10410,"pool":"reaction.hurt","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"WHAT? How could you say that?! I thought you were on my side!"},{"id":10411,"pool":"reaction.hurt","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"I'd never say that about you. Remember that."},{"id":10412,"pool":"reaction.noticed_contradiction","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"I wrote down your last answer. It doesn't match. Which one should I cross out?"},{"id":10413,"pool":"reaction.noticed_contradiction","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"You told me otherwise before. Say what you mean, and mean it every time."},{"id":10414,"pool":"reaction.noticed_contradiction","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Ooh, you changed your answer! What changed your mind? I have to know."}]}
