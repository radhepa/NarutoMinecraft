{"format":1,"lines":[{"id":6755,"pool":"gift.loved","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"For me? Oh, {player}, this is exactly what I wanted. How did you know?"},{"id":6756,"pool":"gift.loved","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"I'm going to keep this somewhere I can see it every morning."},{"id":6757,"pool":"gift.loved","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"You remembered! I mentioned this once, months ago, and you remembered."},{"id":6758,"pool":"gift.loved","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"This is perfect. I don't have the words. Just... thank you."},{"id":6759,"pool":"gift.loved","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"I've been eyeing one of these at the market for weeks. You wonderful person."},{"id":6760,"pool":"gift.loved","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"I'll treasure it. Truly. Nobody's given me anything this right in years."},{"id":6761,"pool":"gift.loved","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"Oh! Oh, look at it. Sit down, I have to show everyone in the house."},{"id":6762,"pool":"gift.loved","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"You must have gone all over the village to find this. Thank you, {player}."},{"id":6763,"pool":"gift.loved","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"This is going on the shelf of things I'd save in a fire."},{"id":6764,"pool":"gift.loved","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":1,"text":"I'm grinning like a fool, aren't I? I can't help it. Thank you."},{"id":6765,"pool":"gift.liked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Thank you, {player}! That's very thoughtful."},{"id":6766,"pool":"gift.liked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Oh, nice. I'll use this, I really will."},{"id":6767,"pool":"gift.liked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"How kind of you. You didn't have to."},{"id":6768,"pool":"gift.liked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I like it! It'll come in handy, I'm sure."},{"id":6769,"pool":"gift.liked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's lovely. Thank you for thinking of me."},{"id":6770,"pool":"gift.liked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Ooh, I've not had one of these in a while. Thanks!"},{"id":6771,"pool":"gift.liked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"A present! You've brightened my afternoon."},{"id":6772,"pool":"gift.liked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Thank you. That's a good choice, you know."},{"id":6773,"pool":"gift.liked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's sweet of you. I'll find a good spot for it."},{"id":6774,"pool":"gift.liked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Well, isn't that nice. Thank you, {player}."},{"id":6775,"pool":"gift.plain","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Thank you. That's kind."},{"id":6776,"pool":"gift.plain","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Oh. A {gift}. Thank you, {player}."},{"id":6777,"pool":"gift.plain","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I'll find a use for it. Thanks."},{"id":6778,"pool":"gift.plain","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's thoughtful of you."},{"id":6779,"pool":"gift.plain","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"How nice. Thank you."},{"id":6780,"pool":"gift.plain","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Thanks. I'll put it with the others."},{"id":6781,"pool":"gift.plain","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Oh, for me? Well, thank you."},{"id":6782,"pool":"gift.plain","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That'll do nicely. Thanks."},{"id":6783,"pool":"gift.plain","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"You're kind to think of me."},{"id":6784,"pool":"gift.plain","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Thank you. I'm sure it'll be useful."},{"id":6785,"pool":"gift.disliked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Oh. Thank you. It's... the thought that counts, isn't it?"},{"id":6786,"pool":"gift.disliked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's, um. Very kind. I'll find somewhere for it."},{"id":6787,"pool":"gift.disliked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I'm not really one for these, but thank you, {player}."},{"id":6788,"pool":"gift.disliked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Ah. Well. I'll pass it on to someone who'll love it. Not that I don't! I just..."},{"id":6789,"pool":"gift.disliked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Thank you. I'll try to like it. I promise I'll try."},{"id":6790,"pool":"gift.disliked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Hm. Not quite my taste. But thank you for trying."},{"id":6791,"pool":"gift.disliked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Oh. You... didn't know. That's fine. Thank you anyway."},{"id":6792,"pool":"gift.disliked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I'll keep it. In a drawer. A nice drawer."},{"id":6793,"pool":"gift.disliked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's thoughtful. It's also not something I'd ever use. Sorry. Thank you."},{"id":6794,"pool":"gift.disliked","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I appreciate it. Really. Let's say no more about it."},{"id":6795,"pool":"gift.hated","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"You thought I'd want this? I... no. Take it back, please."},{"id":6796,"pool":"gift.hated","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Is this a joke, {player}? Because it isn't funny."},{"id":6797,"pool":"gift.hated","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I can't stand these. I thought you'd know that by now."},{"id":6798,"pool":"gift.hated","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Oh. Wow. You really don't know me at all, do you?"},{"id":6799,"pool":"gift.hated","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I'd rather you hadn't given me anything than this."},{"id":6800,"pool":"gift.hated","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Please don't bring me one of these again. Ever."},{"id":6801,"pool":"gift.hated","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"That's... no. No, thank you. Put it away."},{"id":6802,"pool":"gift.hated","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"I've told people I hate these. I suppose you weren't listening."},{"id":6803,"pool":"gift.hated","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Is this what you think of me? I'm a bit hurt, honestly."},{"id":6804,"pool":"gift.hated","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":1,"text":"Keep it. I mean it. I don't want it in my house."},{"id":6805,"pool":"gift.loved","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"You shouldn't have! You really shouldn't! Come in, I'm feeding you for this."},{"id":6806,"pool":"gift.loved","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"You've chosen this with care. I can tell. That matters more than the gift itself."},{"id":6807,"pool":"gift.loved","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"WAIT. Is this for ME? I'm doing a little dance. You can't stop me."},{"id":6808,"pool":"gift.loved","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"This is coming with me on every journey I ever take. Thank you!"},{"id":6809,"pool":"gift.loved","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"Perfect condition, the right kind, and wrapped neatly. You've thought of everything."},{"id":6810,"pool":"gift.loved","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"Thank you, {player}. I'll look after it. I'll have it for years."},{"id":6811,"pool":"gift.loved","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"...This is good. Very good. Thank you."},{"id":6812,"pool":"gift.loved","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"It's beautiful. It's like someone caught a little piece of a dream and handed it to me."},{"id":6813,"pool":"gift.loved","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"Useful and well made. You know how to choose. I'm impressed. And grateful."},{"id":6814,"pool":"gift.loved","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"Where did you find this? How? Who made it? Tell me everything. And thank you!"},{"id":6815,"pool":"gift.loved","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"You spent your own ryo on me? Thank you. Now promise you've kept enough for yourself."},{"id":6816,"pool":"gift.loved","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"Oh... this is so lovely. I'll take such good care of it."},{"id":6817,"pool":"gift.loved","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"This is worthy of my house. You have excellent taste, {player}. I'll say that once."},{"id":6818,"pool":"gift.loved","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"THIS IS THE BEST GIFT EVER! I'm telling everyone! Everyone!"},{"id":6819,"pool":"gift.loved","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"mood":"BLUSH","text":"F-for me? Really? I... I love it. Thank you."},{"id":6820,"pool":"gift.loved","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react","deepen_bond"],"spec":5,"text":"Well chosen. Thank you. I'll use it every day."},{"id":6821,"pool":"gift.hated","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"spec":5,"text":"Oh, dear. I don't want to hurt your feelings, but I really can't have this in the house."},{"id":6822,"pool":"gift.hated","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"I wonder what made you think I'd want this. I'd honestly like to know."},{"id":6823,"pool":"gift.hated","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Ha. Ha. Very funny. ...This isn't a prank? Oh no. It isn't a prank."},{"id":6824,"pool":"gift.hated","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"I'd leave this on the side of the road. Sorry, {player}. Really not for me."},{"id":6825,"pool":"gift.hated","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"This is the one thing I asked people never to give me. I keep a list. You could have asked."},{"id":6826,"pool":"gift.hated","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"I'll be honest with you, since that's what friends are for. I hate this."},{"id":6827,"pool":"gift.hated","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"No."},{"id":6828,"pool":"gift.hated","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"It's the colour of a bad dream. I'm sorry. I can't look at it."},{"id":6829,"pool":"gift.hated","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Waste of good ryo. I'd rather you'd kept your money."},{"id":6830,"pool":"gift.hated","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Why would anyone make one of these? Why would anyone GIVE one of these? I'm baffled."},{"id":6831,"pool":"gift.hated","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"spec":5,"text":"Don't spend your coin on things like this for me. Please. I mean it."},{"id":6832,"pool":"gift.hated","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"Oh... I'm sorry, I just can't. Please don't be upset with me."},{"id":6833,"pool":"gift.hated","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"You insult me with this. Take it away."},{"id":6834,"pool":"gift.hated","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"text":"UGH! No! Anything but this! Why would you do this to me?!"},{"id":6835,"pool":"gift.hated","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"spec":5,"mood":"GLOOM","text":"Oh. Um. I... don't really... I'm sorry."},{"id":6836,"pool":"gift.hated","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"spec":5,"text":"This is unacceptable. Learn what people value before you give them things."}]}
