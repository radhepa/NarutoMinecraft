{"format":1,"lines":[{"id":1,"pool":"again","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":1,"text":"We already caught up today, {player}. Come by tomorrow."},{"id":2,"pool":"again","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":1,"text":"I think I've told you everything I know for one day."},{"id":3,"pool":"again","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":1,"text":"You'll wear my voice out. Tomorrow, all right?"},{"id":4,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Again? Ha! I like you, but I'm out of stories till tomorrow!"},{"id":5,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've talked myself hoarse. Train with me tomorrow instead!"},{"id":6,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We have spoken enough for one day. Go and do something useful with it."},{"id":7,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I said what I had to say. Repetition doesn't improve it."},{"id":8581,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've told you all my news, dear. Come for supper tomorrow and I'll have more."},{"id":8582,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've heard everything twice! Here, at least take a rice ball for the road."},{"id":8583,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Back again? I love it, but I've nothing new. Except leftovers. Always leftovers."},{"id":8584,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've talked your ear off already today. Go and rest, {player}."},{"id":8585,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new since this morning, dear. Just the same old pot on the stove."},{"id":8586,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Tomorrow I'll have gossip and soup. Today, only soup."},{"id":8591,"pool":"again","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I think I've said all I've considered today. Let me gather some new thoughts."},{"id":8592,"pool":"again","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We've covered it, I believe. Tomorrow I may have a better answer."},{"id":8593,"pool":"again","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm out of ideas worth sharing for the day. Give me a night with my books."},{"id":8594,"pool":"again","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Repeating myself would only weaken what I said. Come back tomorrow."},{"id":8595,"pool":"again","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've nothing new to offer just now, {player}. That's honest, at least."},{"id":8596,"pool":"again","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Let what we talked about settle. There'll be more tomorrow."},{"id":8601,"pool":"again","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Again? I've used up all my jokes! Even the bad ones!"},{"id":8602,"pool":"again","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm out of tricks for today. Come back tomorrow, I'll have restocked."},{"id":8603,"pool":"again","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You again! Ha! I've got nothing. Literally. Look, empty pockets."},{"id":8604,"pool":"again","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"If I talk any more I'll just start making noises. Want to hear? No? Fair."},{"id":8605,"pool":"again","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Today's fun is all used up. Tomorrow's fun starts at sunrise!"},{"id":8606,"pool":"again","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've told you everything. Except the secret. Which I'm not telling. Tomorrow, maybe."},{"id":8611,"pool":"again","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've no new stories till I've been somewhere new. Tomorrow, maybe!"},{"id":8612,"pool":"again","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've heard all my roads today. Let me go find another one."},{"id":8613,"pool":"again","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new under this sky, {player}. Give me a day out past the wall."},{"id":8614,"pool":"again","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm all talked out. Time to walk it off."},{"id":8615,"pool":"again","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Same tales as this morning, I'm afraid. I need fresh dirt on my boots."},{"id":8616,"pool":"again","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'll have a new adventure for you tomorrow. Today's is told."},{"id":8621,"pool":"again","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We covered all of that at our last conversation. I have notes."},{"id":8622,"pool":"again","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've nothing further to add today. My list is complete."},{"id":8623,"pool":"again","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"That was already discussed. Same time tomorrow?"},{"id":8624,"pool":"again","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"There's nothing new on today's schedule, {player}."},{"id":8625,"pool":"again","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've said what I planned to say. Repeating it would be inefficient."},{"id":8626,"pool":"again","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Tomorrow I'll have new items for you. Today's are checked off."},{"id":8631,"pool":"again","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've told you what I know. It'll still be true tomorrow."},{"id":8632,"pool":"again","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing's changed since we spoke, {player}."},{"id":8633,"pool":"again","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Same as before. I'll let you know if that changes."},{"id":8634,"pool":"again","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've said my piece. I'll be here tomorrow, same as always."},{"id":8635,"pool":"again","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"That's all I've got today. Come back, I'll have more."},{"id":8636,"pool":"again","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I don't say things twice. Not because I won't. Because once is enough."},{"id":8641,"pool":"again","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"...We talked already."},{"id":8642,"pool":"again","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"That's all."},{"id":8643,"pool":"again","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new."},{"id":8644,"pool":"again","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Tomorrow."},{"id":8645,"pool":"again","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm out of words for today."},{"id":8646,"pool":"again","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Hm. Again?"},{"id":8651,"pool":"again","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"My head's empty as a sky with no clouds. Come back when it's filled up again."},{"id":8652,"pool":"again","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've told you every story I had today. Tomorrow I'll dream new ones."},{"id":8653,"pool":"again","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"The well's dry for today, {player}. Ideas need a night to refill."},{"id":8654,"pool":"again","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'd only be painting the same picture twice. Come back tomorrow."},{"id":8655,"pool":"again","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Today's colours are all used up. Tomorrow's will be brighter."},{"id":8656,"pool":"again","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've nothing new. Unless you count a daydream about a cloud shaped like a teapot."},{"id":8661,"pool":"again","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We've been over this. Time's money, {player}. Come back tomorrow."},{"id":8662,"pool":"again","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new to report. I'll let you know if there is."},{"id":8663,"pool":"again","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've given you everything I've got today. No sense repeating it."},{"id":8664,"pool":"again","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Same news as before. Prices haven't changed either."},{"id":8665,"pool":"again","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm all out. Try me tomorrow."},{"id":8666,"pool":"again","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Talking in circles won't get either of us anywhere."},{"id":8671,"pool":"again","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've asked you all my questions for today! ...Nearly all. Okay, all."},{"id":8672,"pool":"again","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've got nothing new yet. I'm still finding things out. Tomorrow!"},{"id":8673,"pool":"again","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've heard all my rumours. I'll go dig up more."},{"id":8674,"pool":"again","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm out of things to wonder about out loud. That never happens!"},{"id":8675,"pool":"again","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new since we talked. I'll be investigating, though."},{"id":8676,"pool":"again","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'll have new questions by tomorrow. Bigger ones."},{"id":8681,"pool":"again","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We've talked enough today. Go home and rest, {player}."},{"id":8682,"pool":"again","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've nothing more to tell you. Just stay safe."},{"id":8683,"pool":"again","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've heard it all. Now go get something to eat."},{"id":8684,"pool":"again","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new. Which is good. Nothing new means nothing wrong."},{"id":8685,"pool":"again","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've said what I needed to. Keep it in mind."},{"id":8686,"pool":"again","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Same as before. Watch yourself out there."},{"id":8691,"pool":"again","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I think we've talked enough for today. That's all right."},{"id":8692,"pool":"again","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've nothing new, I'm sorry. Come back tomorrow, if you like."},{"id":8693,"pool":"again","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've heard all my little news already."},{"id":8694,"pool":"again","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Let's rest our voices until tomorrow."},{"id":8695,"pool":"again","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing's changed since we spoke. The sparrows are still at the window."},{"id":8696,"pool":"again","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm a bit tired from talking. Maybe tomorrow?"},{"id":8701,"pool":"again","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've already given you my time today. Don't be greedy."},{"id":8702,"pool":"again","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I don't repeat myself, {player}."},{"id":8703,"pool":"again","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"That was settled. There's nothing more to discuss."},{"id":8704,"pool":"again","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've had my thoughts. That's more than most get."},{"id":8705,"pool":"again","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Come back tomorrow, when I've something worth saying."},{"id":8706,"pool":"again","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Twice in a day? You flatter me. Still no."},{"id":8711,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm talked out! For now! I'll be back to full volume tomorrow!"},{"id":8712,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Again?! I love that you keep coming back! But I've got nothing new!"},{"id":8713,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Tomorrow! I'll have ten new things to shout about tomorrow!"},{"id":8714,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've said everything! Twice! Let's train instead!"},{"id":8715,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"My throat's sore from all the talking! Worth it! Come back tomorrow!"},{"id":8716,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new today! But tomorrow's going to be HUGE!"},{"id":8721,"pool":"again","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Oh, um... I think I already said everything."},{"id":8722,"pool":"again","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I don't have anything new. Sorry."},{"id":8723,"pool":"again","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We talked earlier... it was nice, though."},{"id":8724,"pool":"again","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I... can't think of anything else to say. Tomorrow?"},{"id":8725,"pool":"again","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Um. Same as before. Sorry, {player}."},{"id":8726,"pool":"again","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've used up all my brave words for today."},{"id":8731,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We've spoken. Use what I told you."},{"id":8732,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I don't waste words. Neither should you."},{"id":8733,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've had my instruction for the day. Go and practise it."},{"id":8734,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing has changed. Come back when something has."},{"id":8735,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Repetition is for drills, not conversation."},{"id":8736,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Tomorrow. Not before."},{"id":13696,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We already talked! I'd love to keep going, but I've run out of news. Tomorrow?"},{"id":13697,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"That's all my news for today. Come back and I'll have more, I promise."}]}
