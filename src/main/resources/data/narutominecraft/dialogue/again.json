{"format":1,"lines":[{"id":12497,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've told you all my news, dear. Come for supper tomorrow and I'll have more."},{"id":12498,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've heard everything twice! Here, at least take a rice ball for the road."},{"id":12499,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Back again? I love it, but I've nothing new. Except leftovers. Always leftovers."},{"id":12500,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've talked your ear off already today. Go and rest, {player}."},{"id":12501,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new since this morning, dear. Just the same old pot on the stove."},{"id":12502,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Tomorrow I'll have gossip and soup. Today, only soup."},{"id":12507,"pool":"again","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I think I've said all I've considered today. Let me gather some new thoughts."},{"id":12508,"pool":"again","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We've covered it, I believe. Tomorrow I may have a better answer."},{"id":12509,"pool":"again","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm out of ideas worth sharing for the day. Give me a night with my books."},{"id":12510,"pool":"again","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Repeating myself would only weaken what I said. Come back tomorrow."},{"id":12511,"pool":"again","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've nothing new to offer just now, {player}. That's honest, at least."},{"id":12512,"pool":"again","tags":{"personality":{"any":["thoughtful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Let what we talked about settle. There'll be more tomorrow."},{"id":12517,"pool":"again","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Again? I've used up all my jokes! Even the bad ones!"},{"id":12518,"pool":"again","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm out of tricks for today. Come back tomorrow, I'll have restocked."},{"id":12519,"pool":"again","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You again! Ha! I've got nothing. Literally. Look, empty pockets."},{"id":12520,"pool":"again","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"If I talk any more I'll just start making noises. Want to hear? No? Fair."},{"id":12521,"pool":"again","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Today's fun is all used up. Tomorrow's fun starts at sunrise!"},{"id":12522,"pool":"again","tags":{"personality":{"any":["playful"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've told you everything. Except the secret. Which I'm not telling. Tomorrow, maybe."},{"id":12527,"pool":"again","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've no new stories till I've been somewhere new. Tomorrow, maybe!"},{"id":12528,"pool":"again","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've heard all my roads today. Let me go find another one."},{"id":12529,"pool":"again","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new under this sky, {player}. Give me a day out past the wall."},{"id":12530,"pool":"again","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm all talked out. Time to walk it off."},{"id":12531,"pool":"again","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Same tales as this morning, I'm afraid. I need fresh dirt on my boots."},{"id":12532,"pool":"again","tags":{"personality":{"any":["adventurous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'll have a new adventure for you tomorrow. Today's is told."},{"id":12537,"pool":"again","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We covered all of that at our last conversation. I have notes."},{"id":12538,"pool":"again","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've nothing further to add today. My list is complete."},{"id":12539,"pool":"again","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"That was already discussed. Same time tomorrow?"},{"id":12540,"pool":"again","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"There's nothing new on today's schedule, {player}."},{"id":12541,"pool":"again","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've said what I planned to say. Repeating it would be inefficient."},{"id":12542,"pool":"again","tags":{"personality":{"any":["meticulous"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Tomorrow I'll have new items for you. Today's are checked off."},{"id":12547,"pool":"again","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've told you what I know. It'll still be true tomorrow."},{"id":12548,"pool":"again","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing's changed since we spoke, {player}."},{"id":12549,"pool":"again","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Same as before. I'll let you know if that changes."},{"id":12550,"pool":"again","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've said my piece. I'll be here tomorrow, same as always."},{"id":12551,"pool":"again","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"That's all I've got today. Come back, I'll have more."},{"id":12552,"pool":"again","tags":{"personality":{"any":["steadfast"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I don't say things twice. Not because I won't. Because once is enough."},{"id":12557,"pool":"again","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"...We talked already."},{"id":12558,"pool":"again","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"That's all."},{"id":12559,"pool":"again","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new."},{"id":12560,"pool":"again","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Tomorrow."},{"id":12561,"pool":"again","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm out of words for today."},{"id":12562,"pool":"again","tags":{"personality":{"any":["reserved"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Hm. Again?"},{"id":12567,"pool":"again","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"My head's empty as a sky with no clouds. Come back when it's filled up again."},{"id":12568,"pool":"again","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've told you every story I had today. Tomorrow I'll dream new ones."},{"id":12569,"pool":"again","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"The well's dry for today, {player}. Ideas need a night to refill."},{"id":12570,"pool":"again","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'd only be painting the same picture twice. Come back tomorrow."},{"id":12571,"pool":"again","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Today's colours are all used up. Tomorrow's will be brighter."},{"id":12572,"pool":"again","tags":{"personality":{"any":["imaginative"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've nothing new. Unless you count a daydream about a cloud shaped like a teapot."},{"id":12577,"pool":"again","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new to report. I'll let you know if there is."},{"id":12578,"pool":"again","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've given you everything I've got today. No sense repeating it."},{"id":12579,"pool":"again","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm all out. Try me tomorrow."},{"id":12580,"pool":"again","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Talking in circles won't get either of us anywhere."},{"id":12581,"pool":"again","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We've been over this. Time's money, {player}. Come back tomorrow."},{"id":12582,"pool":"again","tags":{"personality":{"any":["pragmatic"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Same news as before. Prices haven't changed either."},{"id":12587,"pool":"again","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've asked you all my questions for today! ...Nearly all. Okay, all."},{"id":12588,"pool":"again","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've got nothing new yet. I'm still finding things out. Tomorrow!"},{"id":12589,"pool":"again","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've heard all my rumours. I'll go dig up more."},{"id":12590,"pool":"again","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm out of things to wonder about out loud. That never happens!"},{"id":12591,"pool":"again","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new since we talked. I'll be investigating, though."},{"id":12592,"pool":"again","tags":{"personality":{"any":["curious"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'll have new questions by tomorrow. Bigger ones."},{"id":12597,"pool":"again","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've nothing more to tell you. Just stay safe."},{"id":12598,"pool":"again","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new. Which is good. Nothing new means nothing wrong."},{"id":12599,"pool":"again","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've said what I needed to. Keep it in mind."},{"id":12600,"pool":"again","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Same as before. Watch yourself out there."},{"id":12601,"pool":"again","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We've talked enough today. Go home and rest, {player}."},{"id":12602,"pool":"again","tags":{"personality":{"any":["protective"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've heard it all. Now go get something to eat."},{"id":12607,"pool":"again","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I think we've talked enough for today. That's all right."},{"id":12608,"pool":"again","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've nothing new, I'm sorry. Come back tomorrow, if you like."},{"id":12609,"pool":"again","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've heard all my little news already."},{"id":12610,"pool":"again","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Let's rest our voices until tomorrow."},{"id":12611,"pool":"again","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing's changed since we spoke. The sparrows are still at the window."},{"id":12612,"pool":"again","tags":{"personality":{"any":["gentle"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm a bit tired from talking. Maybe tomorrow?"},{"id":12617,"pool":"again","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've already given you my time today. Don't be greedy."},{"id":12618,"pool":"again","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I don't repeat myself, {player}."},{"id":12619,"pool":"again","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"That was settled. There's nothing more to discuss."},{"id":12620,"pool":"again","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've had my thoughts. That's more than most get."},{"id":12621,"pool":"again","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Come back tomorrow, when I've something worth saying."},{"id":12622,"pool":"again","tags":{"personality":{"any":["proud"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Twice in a day? You flatter me. Still no."},{"id":12627,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I'm talked out! For now! I'll be back to full volume tomorrow!"},{"id":12628,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Again?! I love that you keep coming back! But I've got nothing new!"},{"id":12629,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Tomorrow! I'll have ten new things to shout about tomorrow!"},{"id":12630,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've said everything! Twice! Let's train instead!"},{"id":12631,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"My throat's sore from all the talking! Worth it! Come back tomorrow!"},{"id":12632,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing new today! But tomorrow's going to be HUGE!"},{"id":12637,"pool":"again","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Oh, um... I think I already said everything."},{"id":12638,"pool":"again","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I don't have anything new. Sorry."},{"id":12639,"pool":"again","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We talked earlier... it was nice, though."},{"id":12640,"pool":"again","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I... can't think of anything else to say. Tomorrow?"},{"id":12641,"pool":"again","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Um. Same as before. Sorry, {player}."},{"id":12642,"pool":"again","tags":{"personality":{"any":["shy"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've used up all my brave words for today."},{"id":12647,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I don't waste words. Neither should you."},{"id":12648,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Nothing has changed. Come back when something has."},{"id":12649,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Repetition is for drills, not conversation."},{"id":12650,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Tomorrow. Not before."},{"id":12651,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We've spoken. Use what I told you."},{"id":12652,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"You've had my instruction for the day. Go and practise it."},{"id":12657,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We already talked! I'd love to keep going, but I've run out of news. Tomorrow?"},{"id":12658,"pool":"again","tags":{"personality":{"any":["warmhearted"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"That's all my news for today. Come back and I'll have more, I promise."},{"id":12662,"pool":"again","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":1,"text":"We already caught up today, {player}. Come by tomorrow."},{"id":12663,"pool":"again","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":1,"text":"I think I've told you everything I know for one day."},{"id":12664,"pool":"again","tags":{"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":1,"text":"You'll wear my voice out. Tomorrow, all right?"},{"id":12665,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"Again? Ha! I like you, but I'm out of stories till tomorrow!"},{"id":12666,"pool":"again","tags":{"personality":{"any":["fiery"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I've talked myself hoarse. Train with me tomorrow instead!"},{"id":12667,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"We have spoken enough for one day. Go and do something useful with it."},{"id":12668,"pool":"again","tags":{"personality":{"any":["stern"]},"stage":{"any":["adult","child","teen"]}},"fn":["react"],"kind":"repeat","spec":5,"text":"I said what I had to say. Repetition doesn't improve it."}]}
